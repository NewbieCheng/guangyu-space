  IMAGE_TO_IMAGE
  EDIT_IMAGE
}

enum ImageGenerationTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  TIMED_OUT
}

model ImageGenerationTask {
  id              String                    @id @default(cuid())
  userId          String                    @map("user_id")
  projectId       String?                   @map("project_id")
  provider        ImageGenerationProvider
  providerTaskId  String?                   @map("provider_task_id")
  providerTaskUrl String?                   @map("provider_task_url")
