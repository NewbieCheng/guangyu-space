model LedgerIdSequence {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  sequenceKey String   @map("sequence_key")
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace LedgerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, name, sequenceKey])
  @@map("ledger_id_sequences")
}

model LedgerRequestDedup {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  userId            String   @map("user_id")
  agentCredentialId String?  @map("agent_credential_id")
  identityKey       String   @map("identity_key")
  operation         String
  idempotencyKey    String   @map("idempotency_key")
  requestHash       String   @map("request_hash")
  responseBody      Json?    @map("response_body")
  resultType        String?  @map("result_type")
  resultId          String?  @map("result_id")
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")

  workspace LedgerWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  credential LedgerAgentCredential? @relation(fields: [agentCredentialId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, identityKey, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("ledger_request_dedup")
}

model LedgerAuditLog {
  id          String           @id @default(cuid())
  workspaceId String?          @map("workspace_id")
  actorUserId String?          @map("actor_user_id")
  source      LedgerAuditSource
  action      String
  recordType  String           @map("record_type")
  recordId    String           @map("record_id")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace LedgerWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([recordType, recordId, createdAt])
  @@map("ledger_audit_logs")
}

model LedgerAgentCredential {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  workspaceId       String    @map("workspace_id")
  name              String
  tokenPrefix       String    @map("token_prefix")
  tokenDigest       String    @unique @map("token_digest")
  scopes            String[]  @default([])
  authVersion       Int       @map("auth_version")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  lastUsedAt        DateTime? @map("last_used_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace   LedgerWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestDedup LedgerRequestDedup[]

  @@index([userId, revokedAt, expiresAt])
  @@index([workspaceId, userId])
  @@map("ledger_agent_credentials")
}
