  name           String?
  receivedOn     DateTime @map("received_on") @db.Date
  amountCents    BigInt   @map("amount_cents")
  method         String
  notes          String?  @db.Text
  version        Int      @default(1)
  createdById    String   @map("created_by_id")
  updatedById    String   @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace LedgerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  order     LedgerOrder?    @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Restrict)
  createdBy User            @relation("LedgerIncomeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User            @relation("LedgerIncomeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, businessNumber])
  @@index([workspaceId, receivedOn, deletedAt])
  @@index([workspaceId, orderId, deletedAt])
  @@map("ledger_incomes")
}

model LedgerResource {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  ownerUserId    String?  @map("owner_user_id")
  businessNumber String   @map("business_number")
  name           String
  category       String?
  purpose        String?  @db.Text
  notes          String?  @db.Text
  version        Int      @default(1)
  createdById    String   @map("created_by_id")
  updatedById    String   @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace  LedgerWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  privateOwner User?          @relation("LedgerResourcePrivateOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  projects   LedgerResourceProject[]
  createdBy  User             @relation("LedgerResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User             @relation("LedgerResourceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, businessNumber])
  @@index([workspaceId, ownerUserId, deletedAt, createdAt])
  @@index([workspaceId, name])
  @@map("ledger_resources")
}

model LedgerResourceProject {
  workspaceId String @map("workspace_id")
  resourceId  String @map("resource_id")
  projectId   String @map("project_id")

  resource LedgerResource @relation(fields: [workspaceId, resourceId], references: [workspaceId, id], onDelete: Restrict)
  project  LedgerProject  @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)

  @@id([workspaceId, resourceId, projectId])
  @@index([workspaceId, projectId])
  @@map("ledger_resource_projects")
}

model LedgerExperience {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  ownerUserId    String   @map("owner_user_id")
  businessNumber String   @map("business_number")
